# Copy to .env only for local development. Do not commit .env or real credential values.

# Google Cloud / Vertex AI
GOOGLE_CLOUD_PROJECT=tripagent-505715
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
# Required only when invoking the real Gemini interpreter.
GEMINI_MODEL_ID=gemini-3.5-flash
# Turns on the background Google Search-grounded Trip Watch in the private worker.
ENABLE_TRIP_WATCH=false
TRIP_WATCH_MAX_CHECKS_PER_TICK=20
# Optional real Google Calendar connection. Keep disabled until the OAuth client,
# exact HTTPS callback, and Secret Manager IAM are configured and approved.
ENABLE_CALENDAR_CONNECTIONS=false
ENABLE_CALENDAR_ACTIONS=false
# CALENDAR_CLIENT_ID=
# CALENDAR_CLIENT_SECRET_RESOURCE_NAME=projects/tripagent-505715/secrets/trip-agent-calendar-oauth-client/versions/latest
# CALENDAR_OAUTH_SIGNING_KEY=
# CALENDAR_REDIRECT_URI=https://edge.example.test/connections/calendar/callback
# OAUTH_REFRESH_TOKENS_SECRET_RESOURCE_NAME=projects/tripagent-505715/secrets/trip-agent-oauth-refresh-tokens
CALENDAR_ID=primary
# Optional Gmail connection. It requests gmail.compose solely to create hotel
# drafts. The implementation never reads the inbox and has no send endpoint.
ENABLE_GMAIL_CONNECTIONS=false
ENABLE_GMAIL_DRAFTS=false
# GMAIL_CLIENT_ID=  # May be the same Google OAuth web client as Calendar.
# GMAIL_CLIENT_SECRET_RESOURCE_NAME=projects/tripagent-505715/secrets/trip-agent-calendar-oauth-client/versions/latest
# GMAIL_OAUTH_SIGNING_KEY=
# GMAIL_REDIRECT_URI=https://edge.example.test/connections/gmail/callback
# Optional live recovery search. This creates an expiring Duffel quote only;
# it never books or pays. Prefer Secret Manager in Cloud Run.
ENABLE_DUFFEL_QUOTES=false
# DUFFEL_ACCESS_TOKEN=
# DUFFEL_ACCESS_TOKEN_SECRET_RESOURCE_NAME=projects/tripagent-505715/secrets/trip-agent-duffel
# Optional judge mode: bounded, read-only Vertex explanations paid by the project.
# Never enable this without a daily quota and billing alert.
ENABLE_JUDGE_MODE=false
JUDGE_DAILY_VERTEX_CALLS=20
JUDGE_DAILY_VERTEX_CALLS_PER_USER=5
JUDGE_MAX_OUTPUT_TOKENS=2048

# Pub/Sub and local workflow mode
PUBSUB_TOPIC_ID=trip-disruptions
PUBSUB_TRANSPORT=local
PROCESS_EVENTS_INLINE=true
SEED_DEMO_DATA=true
EVENT_LEASE_SECONDS=60

# Application
LOG_LEVEL=INFO

# Reserved for later approved milestones. Values must come from Secret Manager or
# the local untracked .env file; placeholders are intentionally not valid secrets.
# APP_ROLE=all is local-only. Cloud Run must use worker or edge.
# APP_ROLE=worker
TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# 32+ random bytes. Keep in Secret Manager; rotating it invalidates pending buttons.
# APPROVAL_CALLBACK_SIGNING_KEY=
ENABLE_PILOT_TRIP=false
# Local/controlled demo trigger only. Leave disabled in normal Cloud Run operation.
ENABLE_SIMULATOR=false
# SIMULATOR_SECRET=
# BYOK remains off until the HTTPS connection page and Secret Manager IAM are approved.
ENABLE_BYOK_CONNECTIONS=false
# CONNECTION_BASE_URL=https://example.test/connect-gemini
# One existing BYOK-only Secret Manager secret. Each traveler key is a separate version;
# Firestore retains only the exact version resource name, never the credential.
# BYOK_SECRET_RESOURCE_NAME=projects/tripagent-505715/secrets/trip-agent-user-gemini
# APP_ROLE=edge belongs only on the minimal public service and requires WORKER_BASE_URL.
# Cloud Run must use APP_ROLE=worker or APP_ROLE=edge; APP_ROLE=all is local-only.
# APP_ROLE=edge
# WORKER_BASE_URL=https://private-worker.example
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=
# OAUTH_STATE_ENCRYPTION_KEY=
# DUFFEL_ACCESS_TOKEN=
# First real observation source: production Amadeus On-Demand Flight Status only.
# Keep both values in Secret Manager for Cloud Run; never send them to Telegram.
ENABLE_AMADEUS_FLIGHT_MONITORING=false
# AMADEUS_CLIENT_ID=
# AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://api.amadeus.com
AMADEUS_MAX_REQUESTS_PER_HOUR=100
